# Copy this file to .env and fill in the values.
# .env is gitignored. Do not commit it.
#
# Gmail accounts need an App Password
# (Google Account, Security, App passwords), not the normal login password.
# Leave the mailbox values blank to run the site and the terminal menu without email.

SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Signs the reservation-form cookie. Use a long random string on any shared host.
SECRET_KEY=

# Set to 1 only on your own machine. Never on a public host.
FLASK_DEBUG=0

# The booking site binds here. Keep 127.0.0.1 unless you trust the network.
HOST=127.0.0.1
PORT=5000

# Public origin for canonical links, Open Graph, and sitemap.xml.
# Example: https://bookings.example.com
SITE_URL=
